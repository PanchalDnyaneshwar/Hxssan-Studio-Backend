# ==============================================================================
# Hxssan Studios — Server Environment Variables Template
# Copy this file to .env for local development or .env.production for production
# ==============================================================================

# Runtime Environment (development | production)
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hxssan_studio
DATABASE_SSL=false

# JWT Secret Key (Use high-entropy string in production)
JWT_SECRET=change_me_to_a_secure_random_key_min_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174